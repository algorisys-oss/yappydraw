---
title: API Sequence Diagram
layout: sequence
hSpacing: 200
vSpacing: 60
---

# Participants — use [actor] for people, [lifeline] for systems
autonumber
user    [actor]    "User"
client  [lifeline] "Client"
gateway [lifeline] "API Gateway"
auth    [lifeline] "Auth Service"
db      [lifeline] "Database"

# Messages: ->> solid call, -->> dashed reply
user ->> client "Click Login"
client ->> gateway "POST /login"
activate gateway

loop "retry up to 3x"
  gateway ->> auth "Validate Credentials"
  auth -->> gateway "200 OK"
end

alt "valid user"
  gateway ->> db "SELECT user"
  db -->> gateway "User Record"
  gateway -->> client "200 OK + token"
else "invalid"
  gateway -->> client "401 Unauthorized"
end

note over gateway,auth "token cached for 15m"
deactivate gateway
client -->> user "Show dashboard"
