# ──────────────────────────────────────────────────────────
# YappyDraw — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# All variables are compile-time only (Vite import.meta.env).
# Set them before running `npm run dev` or `npm run build`.
# ──────────────────────────────────────────────────────────

# ── Workspace Persistence ─────────────────────────────────
# Save/load drawings from the Express backend API.
# Set to 'false' for static-only deployments (e.g. GitHub Pages).
# Default: true
VITE_ENABLE_WORKSPACE_PERSISTENCE=true

# ── Cloud Storage ─────────────────────────────────────────
# Master toggle for all cloud storage features.
# Default: true
VITE_ENABLE_CLOUD_STORAGE=true

# Enable Google Drive as a storage provider.
# Default: true
VITE_ENABLE_GOOGLE_DRIVE=true

# Google OAuth 2.0 Client ID (required for Google Drive).
# Get one from Google Cloud Console:
#   1. Create a project at https://console.cloud.google.com
#   2. Enable Google Drive API
#   3. Go to Google Auth platform → Branding → configure consent screen
#   4. Go to Credentials → Create OAuth client ID (Web application)
#   5. Add redirect URI: http://localhost:5173/oauth-callback.html
# See docs/cloud-storage.md §14 for the full setup guide.
VITE_GOOGLE_CLIENT_ID=

# Google OAuth 2.0 Client Secret (required for Google Drive).
# Found in the same Credentials page as the Client ID.
# Note: This is safe to embed in a SPA — Google's security relies on
# redirect URI / origin restrictions, not the secret itself.
VITE_GOOGLE_CLIENT_SECRET=

# ── Rocket Backend Integration ───────────────────────────
# Toggle Rocket Backend export, deploy, and AI Rocket mode.
# When 'false' or unset, hides: Export to Rocket, Deploy to Rocket,
# "Generate for Rocket Backend" checkbox, and Rocket Settings.
# Default: false (opt-in)
VITE_ENABLE_ROCKET_EXPORT=false
