# ──────────────────────────────────────────────────────────
# YappyDraw — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# All variables are compile-time only (Vite import.meta.env).
# Set them before running `npm run dev` or `npm run build`.
# ──────────────────────────────────────────────────────────

# ── Workspace Persistence ─────────────────────────────────
# Save/load drawings from the Express backend API.
# Set to 'false' for static-only deployments (e.g. GitHub Pages).
# Default: true
VITE_ENABLE_WORKSPACE_PERSISTENCE=true

# ── Cloud Storage ─────────────────────────────────────────
# Master toggle for all cloud storage features.
# Default: true
VITE_ENABLE_CLOUD_STORAGE=true

# Enable Google Drive as a storage provider.
# Default: true
VITE_ENABLE_GOOGLE_DRIVE=true

# Google OAuth 2.0 Client ID (required for Google Drive).
# Get one from Google Cloud Console:
#   1. Create a project at https://console.cloud.google.com
#   2. Enable Google Drive API
#   3. Go to Google Auth platform → Branding → configure consent screen
#   4. Go to Credentials → Create OAuth client ID (Web application)
#   5. Add redirect URI: http://localhost:5173/oauth-callback.html
# See docs/cloud-storage.md §14 for the full setup guide.
VITE_GOOGLE_CLIENT_ID=

# Google OAuth 2.0 Client Secret (required for Google Drive).
# Found in the same Credentials page as the Client ID.
# Note: This is safe to embed in a SPA — Google's security relies on
# redirect URI / origin restrictions, not the secret itself.
VITE_GOOGLE_CLIENT_SECRET=

# ── Rocket Backend Integration ───────────────────────────
# Toggle Rocket Backend export, deploy, and AI Rocket mode.
# When 'false' or unset, hides: Export to Rocket, Deploy to Rocket,
# "Generate for Rocket Backend" checkbox, and Rocket Settings.
# Default: false (opt-in)
VITE_ENABLE_ROCKET_EXPORT=false

# ── Support & Founding Supporters ─────────────────────────
# All three are PUBLIC URLs. They are safe in a client bundle and in the OSS
# mirror. Never put a Razorpay key_secret, webhook secret or SMTP credential in
# this file or any VITE_ variable: Vite inlines every VITE_* value into the
# built JavaScript, which is published.
#
# YappyDraw has no server, so payments are handled by linking out to pages the
# provider hosts. The provider does the checkout, the verification and the
# receipt. See frontend/src/config/support.ts.
#
# Each of these is OPTIONAL and empty by default, on purpose. An unset value
# means the feature is ABSENT rather than broken: the menu item, the header
# button, the command and the API call all hide themselves rather than offer a
# link that goes nowhere. A fork building from the OSS mirror therefore ships no
# Support button pointing at us, which is why no URL is hardcoded in the source.
#
# The consequence to know when deploying: if the Support button is missing from
# a live build, the host is not passing these through to `vite build`. Check
# that before looking anywhere else.

# General support, any amount the payer chooses.
# A razorpay.me handle is enough here.
VITE_SUPPORT_RAZORPAY_URL=

# GitHub Sponsors, for supporters outside India (Razorpay is INR-first and
# international payments need separate enablement on the account).
# Requires a published sponsors profile: until one exists,
# github.com/sponsors/<user> just redirects to the plain profile.
VITE_SUPPORT_GITHUB_URL=

# The Founding Supporter checkout for /founders/.
# MUST be a Razorpay PAYMENT PAGE, not a razorpay.me link. Only a Payment Page
# carries a fixed price and custom input fields, and only its CSV export returns
# email, phone and those fields, which is how the founder list is built.
# Create it in the dashboard (Live mode) at a fixed price, with input fields for
# a preferred name for the credits and a contact handle.
# Unset means /founders/ renders without a buy button and the founders entry
# does not appear in the Support dialog.
VITE_SUPPORT_FOUNDERS_URL=
