# Cache policy for the static deploy (Hostinger / Apache / LiteSpeed).
#
# WHY THIS FILE EXISTS
# -------------------
# The host was serving `index.html` with NO Cache-Control header at all. With no
# freshness directive a browser falls back to *heuristic* caching — commonly 10%
# of the time since Last-Modified — and reuses the cached copy WITHOUT
# revalidating. Every deploy replaces the content-hashed chunks and deletes the
# old ones, so a returning visitor would load a stale index.html that points at
# `/assets/index-OLDHASH.js`, get a 404 (served as an HTML error page, so the
# module parse fails too), and land on the "Something went wrong" boundary.
# Reloading fixed it, which is exactly what made it look random. The more often
# we ship, the more often it happened.
#
# THE RULE
# --------
# Anything with a content hash in its name can be cached forever. Anything that
# names those files — index.html — and anything that controls updates — sw.js,
# workbox-*.js, the manifest — must be revalidated on every visit.
#
# Order matters: these blocks are applied in sequence and `Header set` replaces,
# so the long-lived rule comes first and the must-revalidate rules override it.

<IfModule mod_headers.c>
    # 1. Content-hashed build output — safe to cache for a year.
    <FilesMatch "\.(js|mjs|css|woff2?|ttf|otf|eot|wasm|png|jpe?g|gif|webp|avif|svg|ico|mp4|webm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # 2. HTML entry points — never reuse without asking the server. These are the
    #    files that name the hashed chunks; a stale one is the whole bug above.
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header unset Expires
    </FilesMatch>

    # 3. Service worker + PWA control files. A cached sw.js delays every update by
    #    however long the cache says (browsers cap SW script caching at 24h, which
    #    is still a day of serving a build we've replaced). The manifest and the
    #    workbox runtime ride along for the same reason.
    #
    #    `always set` rather than `set`, and an exact <Files> for sw.js rather than
    #    an alternation: the first version of this block did not take effect on the
    #    live host — sw.js came back with the server's own `public, max-age=604800`
    #    while the .html and asset rules above worked — so this uses the form that
    #    is applied latest and matches most plainly. scripts/verify-deploy.sh
    #    asserts the result rather than trusting it.
    <Files "sw.js">
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header always unset Expires
    </Files>
    <FilesMatch "^(workbox-.*|registerSW)\.js$|^(manifest\.webmanifest|site\.webmanifest)$">
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header always unset Expires
    </FilesMatch>
</IfModule>

# mod_expires can overwrite the Cache-Control that mod_headers just set, and it
# runs whether or not we asked for it — a host-level `ExpiresByType
# application/javascript "access plus 1 week"` is the likeliest explanation for
# sw.js ignoring the block above. Turning it off for the control files puts
# mod_headers back in charge.
<IfModule mod_expires.c>
    <Files "sw.js">
        ExpiresActive Off
    </Files>
</IfModule>

# Some LiteSpeed/Apache setups apply mod_expires on top of the above; keep it
# consistent rather than letting it re-introduce a long HTML lifetime.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---------------------------------------------------------------------------
# URL routing (plan §S1 / §S5)
#
# The public pages are real paths now — `/help/uml/`, `/learn/…` — and most of
# them exist on disk as prerendered `index.html` files, which Apache serves
# directly. The rules below cover the two cases that are NOT on disk:
#
#   1. `/examples/<id>/`, which stays client-rendered (a generated page per
#      template would be thin content — see the plan's §6/D2).
#   2. Nothing else. `/help/…` and `/learn/…` are prerendered in full, so an
#      unknown one under those prefixes is a genuine 404 and is served as one.
#
# Anything else is a genuine 404 and is served as one. A "soft 404" — returning
# the home page with a 200 at a wrong URL — is worse than a real 404, because
# Google indexes it as a duplicate of the home page.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # One canonical host. The site answers on BOTH yappydraw.com and
    # www.yappydraw.com with identical content and no redirect, which splits
    # every ranking signal in two and contradicts the canonical tag (the apex).
    # If the host ever stops serving the apex directly, remove this block first.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteCond %{HTTPS} on
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # A real file or directory always wins — prerendered pages, assets, sw.js.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # The one client-rendered section falls back to the SPA.
    RewriteRule ^examples/.+$ /index.html [L]
</IfModule>

# Everything else. 404.html boots the app for a known section and shows a real
# not-found page otherwise, so the status code and the content agree.
ErrorDocument 404 /404.html
